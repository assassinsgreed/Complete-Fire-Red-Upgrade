// Facility-agnostic strings to be shared by attendants in each facility, with var substitution:
//   - FrontierChallenge_BufferFacilityInfo fills in [BUFFER1] with the facility name, [BUFFER2] with the format and [BUFFER3] with the current streak.
//   - BufferNumMonsToEnter overwrites [BUFFER3] with the number of Pokemon to enter.
//   - StoreChipsToGive overwrites [BUFFER2] with the PokeChip reward.

//------------------------------------------------------------------
// Lobby
//------------------------------------------------------------------

